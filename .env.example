# Server-side only. Never place provider secrets in app.js, index.html, or a VITE_* variable.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=1
SITE_URL=http://localhost:8000

# Database (TiDB Cloud, MySQL compatible)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=hacktoberfeast

# AI providers. Gemma/Gemini is primary; Groq is the fallback.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail SMTP app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
