{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "django"
    },
    "prototype": {
      "root": "prototype",
      "framework": "node",
      "entrypoint": "server.mjs",
      "functions": {
        "server.mjs": {
          "includeFiles": "**/*"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
